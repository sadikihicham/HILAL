{
  "expo": {
    "name": "HILAL",
    "slug": "hilal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hilal",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ae.hilal.hilal"
    },
    "android": {
      "package": "ae.hilal.hilal",
      "adaptiveIcon": {
        "backgroundColor": "#0E1A16",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "24429564-7133-49de-b733-0acbe4c727e1"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1A16",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "deploymentTarget": "16.4"
          }
        }
      ]
    ]
  }
}
