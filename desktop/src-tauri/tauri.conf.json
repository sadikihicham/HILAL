{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HILAL Desktop",
  "version": "1.2.0",
  "identifier": "com.sadikihicham.hilal.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "HILAL",
        "width": 1280,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState",
          "radius": 16
        },
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Moniteur matériel local",
    "longDescription": "HILAL Desktop — moniteur matériel PC 100% local, zéro réseau sortant. Températures, ventilateurs, processus et arrêt de processus.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
